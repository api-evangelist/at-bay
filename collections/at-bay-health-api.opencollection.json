{
  "opencollection": "1.0.0",
  "info": {
    "name": "At-Bay Partner Documents Health API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.at-bay.com/v2/health"
          },
          "docs": "Lightweight liveness probe for the API."
        }
      ]
    }
  ],
  "bundled": true
}